<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. The single backend is the deployed Railway endpoint, so cleartext is
  refused everywhere; there is no emulator/localhost exception any more.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>