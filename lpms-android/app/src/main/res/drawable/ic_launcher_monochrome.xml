<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon silhouette. The launcher tints this itself, so it must be a single flat
  shape on a transparent background.

  Only the capsule outline is drawn. The cross and band are the same colour as the body
  here, so including them would make the mark a plain blob; the silhouette is what still
  reads at launcher size.

  Scaled and centred exactly as ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.40"
        android:scaleY="0.40"
        android:translateX="22"
        android:translateY="22">

        <group
            android:pivotX="80"
            android:pivotY="80"
            android:rotation="40">

            <path
                android:fillColor="#FFFFFF"
                android:pathData="M38,48 A42,42 0 0 1 122,48 L122,112 A42,42 0 0 1 38,112 Z" />
        </group>
    </group>
</vector>