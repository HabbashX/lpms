<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity navigation graph.

  Two zones:
    * Pre-auth (sessionGate / login / changePassword) — no bottom bar, no toolbar.
    * Post-auth (dashboard / more) — shown with the role-driven bottom navigation.

  Global actions let the session layer jump anywhere (401 → login, 403
  PASSWORD_CHANGE_REQUIRED → forced change password) without knowing the caller's graph.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/sessionGateFragment">

    <fragment
        android:id="@+id/sessionGateFragment"
        android:name="com.lpms.ui.auth.SessionGateFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_session_gate" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.lpms.ui.auth.LoginFragment"
        android:label="@string/login" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.lpms.ui.auth.ChangePasswordFragment"
        android:label="@string/change_password_title" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.lpms.ui.home.DashboardFragment"
        android:label="@string/nav_dashboard" />

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.lpms.ui.more.MoreFragment"
        android:label="@string/nav_more" />

    <!-- Drugs + categories. Writes (form, deactivate) are gated to ADMIN/PHARMACIST in
         the UI; the server enforces it as well. -->
    <fragment
        android:id="@+id/drugListFragment"
        android:name="com.lpms.ui.drugs.DrugListFragment"
        android:label="@string/nav_drugs">

        <argument
            android:name="drugId"
            android:defaultValue="0L"
            app:argType="long" />

        <action
            android:id="@+id/action_drugList_to_drugDetail"
            app:destination="@id/drugDetailFragment" />

        <action
            android:id="@+id/action_drugList_to_drugForm"
            app:destination="@id/drugFormFragment" />

        <action
            android:id="@+id/action_drugList_to_categories"
            app:destination="@id/categoriesFragment" />

        <action
            android:id="@+id/action_drugList_to_pricing"
            app:destination="@id/drugPricingFragment" />

        <action
            android:id="@+id/action_drugList_to_receiveStock"
            app:destination="@id/receiveStockFragment" />
    </fragment>

    <fragment
        android:id="@+id/drugDetailFragment"
        android:name="com.lpms.ui.drugs.DrugDetailFragment"
        android:label="@string/nav_drugs">

        <argument
            android:name="drugId"
            app:argType="long" />

<action
            android:id="@+id/action_drugDetail_to_drugForm"
            app:destination="@id/drugFormFragment" />

        <action
            android:id="@+id/action_drugDetail_to_pricing"
            app:destination="@id/drugPricingFragment" />

        <action
            android:id="@+id/action_drugDetail_to_receiveStock"
            app:destination="@id/receiveStockFragment" />
    </fragment>

    <fragment
        android:id="@+id/drugFormFragment"
        android:name="com.lpms.ui.drugs.DrugFormFragment"
        android:label="@string/drug_add_title">

        <!-- drugId > 0 edits that drug; absent/0 creates a new one. -->
        <argument
            android:name="drugId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.lpms.ui.categories.CategoriesFragment"
        android:label="@string/nav_categories" />

    <!-- Recommended pricing: ADMIN/PHARMACIST only (the endpoint exposes cost). -->
    <fragment
        android:id="@+id/drugPricingFragment"
        android:name="com.lpms.ui.pricing.DrugPricingFragment"
        android:label="@string/pricing_title">

        <argument
            android:name="drugId"
            app:argType="long" />
    </fragment>

    <!-- Receive stock: ADMIN/PHARMACIST. Creates an immutable batch. -->
    <fragment
        android:id="@+id/receiveStockFragment"
        android:name="com.lpms.ui.inventory.ReceiveStockFragment"
        android:label="@string/stock_receive_title" />

    <!-- Point of sale. Confirmation lands on the receipt screen. -->
    <fragment
        android:id="@+id/posFragment"
        android:name="com.lpms.ui.pos.PosFragment"
        android:label="@string/nav_pos">

        <action
            android:id="@+id/action_pos_to_saleDetail"
            app:destination="@id/saleDetailFragment"
            app:popUpTo="@id/posFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!--
      Barcode scanner, reachable from both the POS and the drug form. It is a navigation
      destination rather than a fragment dropped into a container view, so closing it -
      by back gesture, toolbar or a successful scan - returns to whichever screen opened
      it, and it can never be left stranded.
    -->
    <fragment
        android:id="@+id/barcodeScannerFragment"
        android:name="com.lpms.ui.pos.scan.BarcodeScannerFragment"
        android:label="@string/pos_scan_barcode" />

    <fragment
        android:id="@+id/saleDetailFragment"
        android:name="com.lpms.ui.sales.SaleDetailFragment"
        android:label="@string/nav_sales">

        <argument
            android:name="saleId"
            app:argType="long" />
    </fragment>

    <!-- Reports: profit summary for a period plus the line-level breakdown. -->
    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.lpms.ui.reports.ReportsFragment"
        android:label="@string/reports_title" />

    <!-- Staff accounts. ADMIN only. -->
    <fragment
        android:id="@+id/userListFragment"
        android:name="com.lpms.ui.users.UserListFragment"
        android:label="@string/nav_users">

        <action
            android:id="@+id/action_userList_to_userForm"
            app:destination="@id/userFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/userFormFragment"
        android:name="com.lpms.ui.users.UserFormFragment"
        android:label="@string/user_add_title">

        <argument
            android:name="userId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!-- Audit log: read-only. ADMIN only. -->
    <fragment
        android:id="@+id/auditListFragment"
        android:name="com.lpms.ui.audit.AuditListFragment"
        android:label="@string/nav_audit_log" />

    <!-- Pharmacy settings. ADMIN only. -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.lpms.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <!--
      Inventory. Batches, low stock, expiring batches and valuation are chips on one screen
      rather than four destinations: they are cross-checked against each other while
      ordering.
    -->
    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.lpms.ui.inventory.InventoryFragment"
        android:label="@string/inventory_title">

        <action
            android:id="@+id/action_inventory_to_drugDetail"
            app:destination="@id/drugDetailFragment" />
    </fragment>

    <!--
      Customers. Every role may read and edit them, and the statement screen is where
      payments are recorded against a debt.
    -->
    <fragment
        android:id="@+id/customerListFragment"
        android:name="com.lpms.ui.customers.CustomerListFragment"
        android:label="@string/nav_customers">

        <action
            android:id="@+id/action_customerList_to_customerDetail"
            app:destination="@id/customerDetailFragment" />
        <action
            android:id="@+id/action_customerList_to_customerForm"
            app:destination="@id/customerFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="com.lpms.ui.customers.CustomerDetailFragment"
        android:label="@string/customer_detail_title">

        <argument
            android:name="customerId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/customerFormFragment"
        android:name="com.lpms.ui.customers.CustomerFormFragment"
        android:label="@string/customer_add_title">

        <argument
            android:name="customerId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!--
      Sales history. Reachable from the More hub, and the destination the POS sends a
      cashier to after a confirmation it could not verify.
    -->
    <fragment
        android:id="@+id/salesListFragment"
        android:name="com.lpms.ui.sales.SalesListFragment"
        android:label="@string/sales_title">

        <argument
            android:name="highlightSaleId"
            android:defaultValue="0L"
            app:argType="long" />

        <action
            android:id="@+id/action_salesList_to_saleDetail"
            app:destination="@id/saleDetailFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_changePassword"
        app:destination="@id/changePasswordFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_home"
        app:destination="@id/dashboardFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_more"
        app:destination="@id/moreFragment" />

    <action
        android:id="@+id/action_global_drugs"
        app:destination="@id/drugListFragment" />

    <action
        android:id="@+id/action_global_categories"
        app:destination="@id/categoriesFragment" />

    <action
        android:id="@+id/action_global_pos"
        app:destination="@id/posFragment" />
</navigation>